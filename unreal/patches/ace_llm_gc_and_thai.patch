     infTask->m_worldContextObject = WorldContextObject;
     infTask->m_chatObj = ChatObj;
     infTask->m_infOptions = Options;
@@ -92,6 +96,7 @@
     }
 
     SetReadyToDestroy();
+    RemoveFromRoot();
 }
 
